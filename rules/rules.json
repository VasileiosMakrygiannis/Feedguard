  "apps": {
    "com.instagram.android": {
      "label": "Instagram",
      "note": "Verified on Instagram 456.0.0.14.78 (2026-11-17). Bottom tabs live in one swipeable ViewPager: Home | Reels | Messages | Search | Profile. The Reels page stays loaded off-screen and slides past when moving between Home and Messages, hence confirmMs.",
      "screens": {
        "ig_dm_thread": {
          "note": "Thread composer id is UNVERIFIED; the inbox action bar is verified.",
          "anyOf": [
            {
              "viewId": "com.instagram.android:id/row_thread_composer_edittext"
            },
            {
              "viewId": "com.instagram.android:id/direct_inbox_action_bar"
            },
            {
              "viewId": "com.instagram.android:id/direct_tab",
              "selected": true
            }
          ]
        },
        "ig_home_feed": {
          "viewId": "com.instagram.android:id/feed_tab",
          "selected": true
        },
        "ig_other_tab": {
          "note": "Recorded so that Messages -> Search -> reel no longer counts as 'from a DM'.",
          "anyOf": [
            {
              "viewId": "com.instagram.android:id/search_tab",
              "selected": true
            },
            {
              "viewId": "com.instagram.android:id/profile_tab",
              "selected": true
            }
          ]
        }
      },
      "rules": [
        {
          "id": "ig_reels_tab",
          "feature": "ig_block_reels",
          "note": "Backup for the cover below: catches swiping the tab pager from Home into Reels.",
          "match": {
            "viewId": "com.instagram.android:id/clips_tab",
            "selected": true
          },
          "confirmMs": 400,
          "action": {
            "type": "clickNode",
            "target": {
              "viewId": "com.instagram.android:id/feed_tab"
            },
            "fallback": "back"
          }
        },
        {
          "id": "ig_reels_viewer",
          "feature": "ig_block_reels",
          "note": "Reel viewer on screen while the Reels tab is not selected: opened from Explore (grid or search), a profile, the feed or a DM.",
          "match": {
            "anyOf": [
              {
                "viewId": "com.instagram.android:id/clips_viewer_view_pager"
              },
              {
                "viewId": "com.instagram.android:id/clips_viewer_container"
              }
            ]
          },
          "confirmMs": 400,
          "allowIf": [
            {
              "setting": "ig_allow_dm_reels",
              "cameFrom": "ig_dm_thread",
              "revokeOnScrollOf": "com.instagram.android:id/clips_viewer_view_pager",
              "withinMs": 600000
            },
            {
              "setting": "ig_allow_feed_reels",
              "cameFrom": "ig_home_feed",
              "revokeOnScrollOf": "com.instagram.android:id/clips_viewer_view_pager",
              "withinMs": 600000
            }
          ],
          "action": {
            "type": "back"
          }
        }
      ],
      "covers": [
        {
          "id": "ig_reels_button",
          "feature": "ig_block_reels",
          "note": "Whole Reels tab blocks touches; the visible tile is drawn only over the tab's icon so it matches the other icons.",
          "target": {
            "viewId": "com.instagram.android:id/clips_tab"
          },
          "label": "⊘",
          "hideWhileSliding": false,
          "visual": {
            "viewId": "com.instagram.android:id/tab_icon"
          },
          "visualScale": 1.25
        },
        {
          "id": "ig_explore_grid",
          "feature": "ig_hide_explore_grid",
          "note": "Grey cover over the Explore grid only. Shown while the Search tab is selected and grid tiles exist (search results have none). Starts below the search bar when it is visible; Instagram slides that bar away while scrolling.",
          "match": {
            "allOf": [
              {
                "viewId": "com.instagram.android:id/search_tab",
                "selected": true
              },
              {
                "viewId": "com.instagram.android:id/grid_card_layout_container"
              }
            ]
          },
          "target": {
            "viewId": "com.instagram.android:id/layout_recyclerview_parent_container"
          },
          "label": "Explore feed hidden",
          "below": {
            "viewId": "com.instagram.android:id/explore_action_bar"
          },
          "color": "#FF8E8E93",
          "hideWhileSliding": true
        }
      ],
      "pagers": [
        "com.instagram.android:id/swipeable_tab_view_pager",
        "com.instagram.android:id/swipeable_nav_view_pager_inner_recycler_view"
      ],
      "scrollSources": [
        "android:id/list",
        "com.instagram.android:id/recycler_view",
        "com.instagram.android:id/clips_viewer_view_pager"
      ]
    },
    "com.google.android.youtube": {
      "label": "YouTube",
      "note": "Verified 2026-11-17 on the user's phone. Bottom bar (pivot_bar) buttons have no ids; they're found by content description + class. Normal videos (watch_while) are never matched.",
      "rules": [
        {
          "id": "yt_shorts_tab",
          "feature": "yt_block_shorts",
          "note": "Shorts tab selected in the bottom bar.",
          "match": {
            "contentDesc": "@yt_shorts",
            "className": "Button",
            "selected": true
          },
          "confirmMs": 400,
          "action": {
            "type": "clickNode",
            "target": {
              "contentDesc": "@yt_home",
              "className": "Button"
            },
            "fallback": "back"
          }
        },
        {
          "id": "yt_shorts_player",
          "feature": "yt_block_shorts",
          "note": "Shorts player opened from the Home shelf, search, a channel or a link.",
          "match": {
            "anyOf": [
              {
                "viewId": "com.google.android.youtube:id/reel_watch_fragment_root"
              },
              {
                "viewId": "com.google.android.youtube:id/reel_recycler"
              },
              {
                "viewId": "com.google.android.youtube:id/reel_player_page_container"
              }
            ]
          },
          "confirmMs": 400,
          "action": {
            "type": "back"
          }
        }
      ],
      "covers": [
        {
          "id": "yt_shorts_button",
          "feature": "yt_block_shorts",
          "note": "Touch-blocking tile over the Shorts button; drawn icon-sized over its image.",
          "target": {
            "contentDesc": "@yt_shorts",
            "className": "Button"
          },
          "visual": {
            "viewId": "com.google.android.youtube:id/image"
          },
          "visualScale": 1.25,
          "label": "⊘"
        }
      ],
      "scrollSources": [
        "com.google.android.youtube:id/results",
        "com.google.android.youtube:id/reel_recycler"
      ]
    },
    "com.zhiliaoapp.musically": {
      "label": "TikTok",
      "note": "TikTok obfuscates most ids; 'viewpager' (the vertical feed) is one of the few readable, stable ones. Verified on com.zhiliaoapp.musically 2026-11-17; trill shares the codebase (unverified). DMs/inbox have no feed pager, so they stay usable. Since 47.x the main tab container (obfuscated class) is also id 'viewpager' on every tab, so the feed rule also requires className ViewPager (androidx.viewpager.widget.ViewPager; verified 47.9.3, 2026-11-22).",
      "rules": [
        {
          "id": "tt_feed",
          "feature": "tt_block_feed",
          "note": "Feed blocked: switch to Inbox (fallback: back, e.g. from a DM video back to the chat). A video opened from a chat is allowed until you swipe to the next one.",
          "match": {
            "viewId": "com.zhiliaoapp.musically:id/viewpager",
            "className": "ViewPager"
          },
          "confirmMs": 300,
          "action": {
            "type": "clickNode",
            "target": {
              "contentDesc": "@tt_inbox",
              "className": "FrameLayout"
            },
            "fallback": "back"
          },
          "allowIf": [
            {
              "setting": "tt_allow_dm_videos",
              "cameFrom": "tt_dm_chat",
              "revokeOnScrollOf": "com.zhiliaoapp.musically:id/viewpager",
              "withinMs": 600000
            },
            {
              "setting": "tt_allow_profile_videos",
              "cameFrom": "tt_profile",
              "revokeOnScrollOf": "com.zhiliaoapp.musically:id/viewpager",
              "withinMs": 600000
            }
          ]
        }
      ],
      "scrollSources": [
        "com.zhiliaoapp.musically:id/viewpager"
      ],
      "covers": [
        {
          "id": "tt_home_tab",
          "feature": "tt_block_feed",
          "note": "Tile over the Home (For You) tab icon.",
          "target": {
            "contentDesc": "@tt_home",
            "className": "FrameLayout"
          },
          "visual": {
            "className": "ImageView"
          },
          "label": "⊘"
        },
        {
          "id": "tt_friends_tab",
          "feature": "tt_block_feed",
          "note": "Friends is also a video feed.",
          "target": {
            "contentDesc": "@tt_friends",
            "className": "FrameLayout"
          },
          "visual": {
            "className": "ImageView"
          },
          "label": "⊘"
        }
      ],
      "screens": {
        "tt_dm_chat": {
          "note": "Chat screen: the message input bar (one of the few readable TikTok ids), or Phone + More buttons.",
          "anyOf": [
            {
              "viewId": "com.zhiliaoapp.musically:id/ui_slot_input_layout_redesign"
            },
            {
              "allOf": [
                {
                  "contentDesc": "@tt_phone"
                },
                {
                  "contentDesc": "@tt_more"
                }
              ]
            }
          ]
        },
        "tt_profile": {
          "note": "Profile tab (your videos, reposts, saved and liked): a video opened here is allowed until you swipe on (tt_allow_profile_videos).",
          "contentDesc": "@tt_profile",
          "className": "FrameLayout",
          "selected": true
        },
        "tt_other": {
          "note": "Any main tab: overwrites the DM origin so other videos don't inherit the exception.",
          "anyOf": [
            {
              "contentDesc": "@tt_inbox",
              "className": "FrameLayout",
              "selected": true
            },
            {
              "contentDesc": "@tt_home",
              "className": "FrameLayout",
              "selected": true
            }
          ]
        }
      }
    },
