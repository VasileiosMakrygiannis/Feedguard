    "com.facebook.katana": {
      "label": "Facebook",
      "note": "Facebook strips view ids ('(name removed)'), so everything matches content descriptions. Tabs: 'Home, tab 1 of 6', 'Reels, tab 2 of 6[, N new]'. There is no Watch tab in this version. Verified 2026-11-17; feed-reel viewer verified 2026-11-22 (588.0.0.42.55).",
      "rules": [
        {
          "id": "fb_reels_tab",
          "feature": "fb_block_reels",
          "match": {
            "contentDescContains": "@fb_reels_tab",
            "selected": true
          },
          "confirmMs": 400,
          "action": {
            "type": "clickNode",
            "target": {
              "contentDescContains": "@fb_home_tab"
            },
            "fallback": "back"
          }
        },
        {
          "id": "fb_reels_viewer",
          "feature": "fb_block_reels",
          "note": "Full-screen reel player (ImmersiveActivity) opened from the feed's Reels shelf, a profile or a link. Verified on 588.0.0.42.55 (2026-11-22): its comment bar has the internal, language-independent id FbShortsComposerAttachmentComponentSpec_*; fallback: the full-screen Button described 'Reel' next to the Save button.",
          "match": {
            "anyOf": [
              {
                "contentDescContains": "FbShortsComposerAttachmentComponentSpec"
              },
              {
                "allOf": [
                  {
                    "contentDesc": "Reel",
                    "className": "Button"
                  },
                  {
                    "contentDescContains": "@fb_save"
                  }
                ]
              }
            ]
          },
          "confirmMs": 400,
          "action": {
            "type": "back"
          }
        }
      ],
      "covers": [
        {
          "id": "fb_reels_button",
          "feature": "fb_block_reels",
          "note": "Facebook's tabs have no icon child; draw the tile at half the tab size.",
          "target": {
            "contentDescContains": "@fb_reels_tab"
          },
          "visualScale": 0.5,
          "label": "⊘"
        }
      ]
    },
